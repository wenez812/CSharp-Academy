# Get a token from @BotFather
BOT_TOKEN=123456:replace_with_your_bot_token
# Public HTTPS URL of the web app, e.g. https://academy.example.com
WEBAPP_URL=https://your-domain.example.com
# Keep false in production. true allows access without Telegram auth for local development only.
DEV_MODE=false
# Public code runner endpoint; availability and C# version support may change.
RUNNER_URL=https://emkc.org/api/v2/piston/execute
